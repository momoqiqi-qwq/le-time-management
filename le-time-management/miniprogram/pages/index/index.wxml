<view wx:if="{{err}}" class="err">{{err}}</view>
<view class="head">U-Time · 今日</view>
<view class="date">{{dateStr}} {{updated ? "· 更新于 " + updated : ""}}</view>

<view class="sec">今日时间块</view>
<block wx:if="{{blocks.length}}">
  <view wx:for="{{blocks}}" wx:key="id" class="block {{item.past ? 'past' : ''}} {{item.now ? 'now' : ''}}">
    <view class="bn">{{item.title}}{{item.now ? " · 进行中" : ""}}</view>
    <view class="bm">{{item.start}} – {{item.end}} · {{item.durMin}} 分钟</view>
  </view>
</block>
<view wx:else class="empty">今天没有时间块</view>

<view class="sec">今日任务</view>
<view class="add">
  <input placeholder="快速添加任务" value="{{newTitle}}" bindinput="newTitleInput" bindconfirm="addTask" />
  <button bindtap="addTask">添加</button>
</view>
<block wx:if="{{tasks.length}}">
  <view wx:for="{{tasks}}" wx:key="id" class="task {{item.done ? 'done' : ''}}">
    <view class="cb" bindtap="toggle" data-id="{{item.id}}">{{item.done ? "✓" : ""}}</view>
    <view>
      <view class="tt">{{item.title}}</view>
      <view class="tm">象限 {{item.quad}} · {{item.estMin}} 分钟{{item.due ? " · 截止 " + item.due : ""}}</view>
    </view>
  </view>
</block>
<view wx:else class="empty">任务都完成了 🎉</view>

<input placeholder="关键词过滤" bindinput="kwInput" style="margin-top:10px" />
<button class="refresh" bindtap="load">⟳ 刷新</button>
