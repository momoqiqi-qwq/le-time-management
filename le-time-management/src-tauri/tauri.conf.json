{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Le时间管理",
  "version": "0.36.5",
  "identifier": "com.yile.letime",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Le时间管理 · 时间块与四象限",
        "width": 1440,
        "height": 900,
        "minWidth": 400,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "shortDescription": "Le时间管理 · 时间块与四象限",
    "longDescription": "Le时间管理：本地优先的时间管理平台，整合四象限、时间块、课程表与插件扩展，支持 Windows / Linux / Android。",
    "targets": [
      "nsis",
      "msi",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "windows": {
      "wix": {
        "language": [
          "zh-CN"
        ]
      }
    }
  }
}
