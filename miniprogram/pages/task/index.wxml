<view class="page-body" wx:if="{{t}}">
  <view class="card">
    <input class="title-in" value="{{t.title}}" maxlength="-1" bindblur="onTitleBlur" />
    <view class="kv">
      <text class="k">状态</text>
      <button class="btn small {{t.done ? 'ghost' : 'pri'}}" bindtap="onToggleDone">
        {{t.done ? "↩ 标记未完成" : "✓ 标记完成"}}
      </button>
    </view>
  </view>

  <view class="card">
    <view class="at">归 类</view>
    <view class="kv">
      <text class="k">象限</text>
      <view class="quadpick">
        <view
          wx:for="{{quads}}"
          wx:key="q"
          class="qp q{{item.q}} {{t.quad === item.q ? 'on' : ''}}"
          data-q="{{item.q}}"
          bindtap="onQuadTap"
        >{{item.rn}}</view>
      </view>
    </view>
    <view class="kv">
      <text class="k">预估</text>
      <picker mode="selector" range="{{estLabels}}" value="{{estIndex}}" bindchange="onEstChange">
        <view class="pv">{{estLabels[estIndex]}} ▾</view>
      </picker>
    </view>
    <view class="kv"><text class="k">自定义分钟</text><input class="inline-in" type="number" value="{{customEst}}" bindblur="onCustomEst" /></view>
    <view class="kv">
      <text class="k">截止</text>
      <view class="duerow">
        <picker mode="date" value="{{due}}" bindchange="onDueChange">
          <view class="pv">{{due || "选择日期"}} ▾</view>
        </picker>
        <text wx:if="{{due}}" class="clr" bindtap="onDueClear">清除</text>
      </view>
    </view>
    <view class="kv">
      <text class="k">截止时间</text>
      <picker mode="time" value="{{dueTime}}" bindchange="onDueTimeChange"><view class="pv">{{dueTime}} ▾</view></picker>
    </view>
    <view class="kv">
      <text class="k">任务提醒</text>
      <switch checked="{{reminderEnabled}}" bindchange="onReminderToggle" />
    </view>
    <view class="kv col" wx:if="{{reminderEnabled}}">
      <text class="k">提前预警</text>
      <view class="reminder-picks">
        <button wx:for="{{reminderOptions}}" wx:key="offset" class="rchip {{item.selected ? 'on' : ''}}" data-offset="{{item.offset}}" bindtap="onReminderPreset">{{item.label}}</button>
      </view>
      <view class="custom-reminder"><input type="number" value="{{customReminderMin}}" bindinput="onReminderCustomInput" placeholder="自定义分钟"/><button class="btn ghost small" bindtap="onReminderCustomAdd">添加</button></view>
      <view wx:for="{{customReminderOffsets}}" wx:key="*this" class="custom-tag">自定义：提前 {{item}} 分钟</view>
    </view>
    <view class="kv">
      <text class="k">项目</text>
      <input class="inline-in" value="{{t.project}}" placeholder="无" maxlength="30" bindblur="onProjectBlur" />
    </view>
    <view class="kv col"><text class="k">标签（逗号分隔）</text><input class="input" value="{{tagsText}}" maxlength="-1" bindblur="onTagsBlur" /></view>
    <view class="kv col">
      <text class="k">备注</text>
      <textarea class="textarea" value="{{t.note}}" placeholder="补充说明…" maxlength="16000" disabled="{{noteTooLong}}" bindblur="onNoteBlur"></textarea>
      <view wx:if="{{noteTooLong}}" class="desc">备注较长，当前仅预览前 16000 字，不会截断原文。可导出完整文本或在桌面端编辑。</view><button class="btn ghost small" bindtap="onExportNote">导出完整备注</button>
    </view>
  </view>

  <view class="card" wx:if="{{sched.length}}">
    <view class="at">已 排 时 间</view>
    <view wx:for="{{sched}}" wx:key="id" class="srow"><view data-date="{{item.date}}" bindtap="onViewSchedule">{{item.label}}</view><button class="btn ghost small" data-id="{{item.id}}" bindtap="onUnschedule">移除这条排程</button></view>
  </view>

  <view class="card">
    <view class="at">图 片 附 件</view><view class="desc">照片保存在本机并随 JSON 备份互通。最多新增到 6 张，每张 512KB 内；桌面导入的已有附件保留。</view>
    <view class="atts"><view wx:for="{{attachments}}" wx:key="index" class="attachment-cell"><image wx:if="{{item.thumb}}" class="att" src="{{item.thumb}}" mode="aspectFill" data-i="{{item.index}}" bindtap="onAttTap"/><view wx:else class="attachment-placeholder" data-i="{{item.index}}" bindtap="onAttTap">{{item.label}}</view><button class="btn ghost small" data-i="{{item.index}}" catchtap="onRemoveAttachment">移除</button></view></view>
    <button class="btn ghost small" loading="{{addingImage}}" disabled="{{addingImage}}" bindtap="onAddAttachment">选择图片 / 拍照</button>
  </view>
  <view class="card"><view class="kv"><text class="k">排程日期</text><picker mode="date" value="{{scheduleDate}}" bindchange="onScheduleDate"><view class="pv">{{scheduleDate}} ▾</view></picker></view><view class="desc">自动选择首个空闲时段，仅替换这一天的安排。</view></view>

  <view class="foot">
    <button class="btn pri" bindtap="onScheduleToday">排入选中日期</button>
    <button class="btn danger" bindtap="onDelete">删除任务</button>
  </view>
  <view wx:if="{{undoMessage}}" class="mini-undo"><text>{{undoMessage}}</text><button class="btn ghost small" bindtap="onUndo">撤销</button></view>
</view>
