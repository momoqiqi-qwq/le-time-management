<view class="page-body tb">
  <!-- 视图切换收进展开菜单（v0.38.0）。
       原来 7 个 tab 横排 + scroll-x，一屏只看得到 4 个半，
       「卡片时间轴 / 年度甘特 / 阶段甘特」永远藏在滑动条后面。
       改成「当前样式名 + 展开按钮」，点开列出全部 7 项并带说明。 -->
  <view class="vt-bar">
    <text class="vt-lead">时间视图</text>
    <view class="vt-toggle" hover-class="press" bindtap="onViewMenuToggle">
      <text class="vt-name">{{viewModeLabel}}</text>
      <view class="vt-caret {{viewMenuOpen ? 'up' : ''}}"></view>
    </view>
  </view>
  <view wx:if="{{viewMenuOpen}}" class="vt-mask" bindtap="onViewMenuClose"></view>
  <view wx:if="{{viewMenuOpen}}" class="vt-menu">
    <view
      wx:for="{{viewTabs}}"
      wx:key="id"
      class="vt-item {{viewMode === item.id ? 'on' : ''}}"
      data-mode="{{item.id}}"
      hover-class="press"
      bindtap="onViewTap"
    >
      <view class="vt-item-main">
        <text class="vt-item-label">{{item.label}}</text>
        <text class="vt-item-desc">{{item.desc}}</text>
      </view>
      <text wx:if="{{viewMode === item.id}}" class="vt-item-check">✓</text>
    </view>
  </view>

  <view wx:if="{{viewMode === 'day'}}" class="day-view">
  <!-- 长按放置模式提示条 -->
  <view wx:if="{{placing}}" class="placebar">
    <view class="pt1">放置「{{placing.title}}」· 在时间轴上点一下开始的位置</view>
    <view class="pt2" hover-class="press" bindtap="onPlaceCancel">取消</view>
  </view>

  <!-- 日期导航 -->
  <view class="tl-head card">
    <view class="dnav">
      <view class="dnav-btn" hover-class="press" bindtap="onPrevDay">‹</view>
      <view class="dnav-btn" hover-class="press" bindtap="onToday">◎</view>
      <view class="dnav-btn" hover-class="press" bindtap="onNextDay">›</view>
    </view>
    <picker mode="date" value="{{curDate}}" bindchange="onDateChange">
      <view class="dlabel">
        <text class="d">{{dateLabel}}</text>
        <text class="sum">{{sumLabel}}</text>
      </view>
    </picker>
  </view>

  <!-- 近 7 天日期条 -->
  <scroll-view class="days" scroll-x show-scrollbar="{{false}}">
    <view class="days-inner">
      <view
        wx:for="{{daysBar}}"
        wx:key="date"
        class="dchip {{item.active ? 'on' : ''}}"
        data-date="{{item.date}}"
        hover-class="press"
        bindtap="onDayTap"
      >
        <text class="dmd">{{item.md}}</text>
        <text class="dwk">{{item.wk}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 任务池 -->
  <view class="pool">
    <view class="pt">待安排 · {{pool.length}} 件<text class="pt-hint">点卡片自动安排 · 长按可放到指定时间</text></view>
    <scroll-view wx:if="{{pool.length}}" class="plist" scroll-x show-scrollbar="{{false}}">
      <view class="plist-inner">
        <view
          wx:for="{{pool}}"
          wx:key="id"
          class="ptask"
          hover-class="press"
          data-id="{{item.id}}"
          bindtap="onPoolTap"
          bindlongpress="onPoolLongPress"
        >
          <view class="n">{{item.title}}</view>
          <view class="m">
            <text class="cat-pill cat-{{item.cat}}">{{item.catLabel}}</text>
            <text>{{item.estLabel}}</text>
            <text wx:if="{{item.dueLabel}}">{{item.dueLabel}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view wx:else class="empty pool-empty">全部安排完了</view>
  </view>

  <!-- 时间轴 -->
  <view class="canvas card" style="height:{{canvasH}}px" bindtap="onCanvasTap">
    <view wx:for="{{hours}}" wx:key="top" class="hour-row" style="top:{{item.top}}px">
      <text class="h">{{item.label}}</text>
    </view>
    <view wx:if="{{emptyDay}}" class="day-empty">
      <view>这一天还是空的</view>
      <view>点空白处加一段 · 或点上方任务卡自动安排</view>
    </view>
    <movable-area class="ma">
      <movable-view
        wx:for="{{blocks}}"
        wx:key="id"
        class="block cat-{{item.cat}} {{item.tiny ? 'tiny' : ''}} {{item.id === dragId ? 'dragging' : ''}}"
        style="height:{{item.h}}px"
        direction="vertical"
        damping="60"
        x="0"
        y="{{item.y}}"
        data-id="{{item.id}}"
        bindtouchstart="onBlockTouchStart"
        bindchange="onBlockChange"
        bindtouchend="onBlockTouchEnd"
      >
        <view class="bn">{{item.title}}</view>
        <view wx:if="{{item.showMeta}}" class="bm">{{item.timeLabel}} · {{item.catLabel}}</view>
      </movable-view>
    </movable-area>
    <view wx:if="{{nowLine.show}}" class="now-line" style="top:{{nowLine.top}}px">
      <text class="t">{{nowLine.label}}</text>
    </view>
    <view wx:if="{{hint.show}}" class="drop-hint" style="top:{{hint.top}}px">
      <text class="hl">{{hint.label}}</text>
    </view>
  </view>

  <!-- 概览 -->
  <view class="card">
    <view class="at">这 天 已 排</view>
    <view class="bigrow">
      <text class="big">{{totalLabel}}</text>
      <text class="small">/ {{awakeLabel}} 清醒时间</text>
    </view>
    <view class="meter" wx:if="{{meter.length}}">
      <view wx:for="{{meter}}" wx:key="cat" class="seg cat-{{item.cat}}" style="width:{{item.w}}%"></view>
    </view>
    <view class="legend">
      <view wx:for="{{legend}}" wx:key="cat" class="lg">
        <view class="dot cat-{{item.cat}}"></view>
        <text>{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="at">近 7 天节奏</view>
    <view class="rhythm">
      <view wx:for="{{rhythm}}" wx:key="i" class="r {{item.today ? 'today' : ''}}">
        <view class="rbar"><view class="fill" style="height:{{item.h}}%"></view></view>
        <text class="rd">{{item.day}}</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="at">明 天 预 告</view>
    <view wx:if="{{tomEmpty}}" class="empty">明天还是空的，去安排一下吧</view>
    <view wx:for="{{tomorrow}}" wx:key="id" class="trow">
      <view class="dot cat-{{item.cat}}"></view>
      <text class="tlabel">{{item.label}}</text>
      <text class="du">{{item.dur}}</text>
    </view>
  </view>

  <!-- 底部快速输入 -->
  <view class="addbar">
    <input
      class="input"
      placeholder="加一段空白时间，如「午休」"
      value="{{quick}}"
      confirm-type="done"
      bindinput="onQuickInput"
      bindconfirm="onQuickAdd"
    />
    <button class="btn pri small" bindtap="onQuickAdd">添加</button>
  </view>
  </view>

  <view wx:elif="{{viewMode === 'wakeup'}}" class="viz-panel wakeup-mini-panel">
    <view class="viz-head">
      <text class="vh-title">WakeUp 课表</text>
      <text class="vh-meta">{{wakeupWeekLabel}}</text>
    </view>
    <!-- 原为 7 列 × 15 时的横向网格（1740rpx 起），窄屏必须左右滑动才看得全。
         改成「按天折叠」：默认只展开今天，其余收起。 -->
    <view class="wk-days">
      <view wx:for="{{wakeupDays}}" wx:key="date" class="fold {{item.today ? 'is-today' : ''}}">
        <view class="fold-head" data-key="{{item.date}}" hover-class="press" bindtap="onFoldTap">
          <view class="fold-title">
            <text class="fold-name">{{item.name}}</text>
            <text class="fold-meta">{{item.md}} · {{item.count}} 块 · {{item.sumLabel}}</text>
          </view>
          <view class="fold-caret {{item.open ? 'up' : ''}}"></view>
        </view>
        <view wx:if="{{item.open}}" class="fold-body wk-days">
          <view wx:if="{{!item.count}}" class="fold-empty">这一天没有安排</view>
          <view wx:for="{{item.blocks}}" wx:for-item="b" wx:key="id" class="wk-row cat-{{b.cat}}">
            <view class="wk-row-time">{{b.timeLabel}}</view>
            <view class="wk-row-main">
              <text class="wk-row-title">{{b.title}}</text>
              <text class="wk-row-meta">{{b.catLabel}}{{b.meta ? ' · ' + b.meta : ''}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'milestone'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">里程碑</text></view>
    <!-- 原为横向轨道（每格固定 250rpx）→ 纵向时间线 -->
    <view class="ms-list">
      <view wx:if="{{!visualEvents.length}}" class="fold-empty">添加带日期的任务或时间块后，这里会自动生成</view>
      <view wx:for="{{visualEvents}}" wx:key="index" class="ms-item" style="--ms:{{item.color}}">
        <view class="ms-rail">
          <view class="ms-node"></view>
        </view>
        <view class="ms-card">
          <view class="ms-row1">
            <text class="ms-date" style="background:{{item.color}}">{{item.md}}</text>
            <text class="ms-year-l">{{item.year}}</text>
          </view>
          <text class="ms-title">{{item.title}}</text>
          <text class="ms-sub">{{item.catLabel}} · {{item.sub}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'chronicle'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">横向时间轴</text></view>
    <!-- 原为 3900rpx 画布 + 绝对定位左右交错，窄屏文字叠成一团 → 纵向年表 -->
    <view class="chron-v">
      <view wx:if="{{!visualEvents.length}}" class="fold-empty">添加带日期的任务或时间块后，这里会自动生成</view>
      <view wx:for="{{visualEvents}}" wx:key="index" class="chron-v-item {{item.side}}" style="--ec:{{item.color}}">
        <view class="chron-v-card">
          <text class="cv-title">{{item.title}}</text>
          <text class="cv-sub">{{item.date}} · {{item.sub}}</text>
        </view>
        <view class="chron-v-dot"></view>
        <text class="chron-v-date" style="background:{{item.color}}">{{item.md}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'cards'}}" class="viz-panel cards-mobile">
    <view class="viz-head"><text class="vh-title">卡片时间轴</text></view>
    <!-- 原为左右交错（窄屏靠 @media(max-width:340px) 降级成单列）→ 直接单列，不再按屏宽分叉 -->
    <view class="cards-axis"></view>
    <view wx:if="{{!visualEvents.length}}" class="fold-empty">添加带日期的任务或时间块后，这里会自动生成</view>
    <view wx:for="{{visualEvents}}" wx:key="index" class="timeline-card {{item.side}}" style="--ct:{{item.color}}">
      <view class="tm-card" style="background:{{item.color}}22;border-color:{{item.color}}">
        <text class="tm-date">{{item.date}}</text><text class="tm-title">{{item.title}}</text><text class="tm-sub">{{item.sub}}</text>
      </view>
      <view class="tm-link" style="border-color:{{item.color}}"></view>
    </view>
  </view>

  <view wx:elif="{{viewMode === 'gantt'}}" class="viz-panel">
    <view class="viz-head"><text class="vh-title">年度甘特</text><text class="vh-meta">{{ganttYear}} 年</text></view>
    <!-- 原为 12 月 × 月度格 + 320rpx 标签（1900rpx 起）→ 按月折叠 -->
    <view class="gm-folds">
      <view wx:if="{{!visualGantt.length}}" class="fold-empty">还没有未完成的任务</view>
      <view wx:for="{{ganttMonths}}" wx:key="m" class="fold {{item.isNow ? 'is-today' : ''}}">
        <view class="fold-head" data-key="gm-{{item.m}}" hover-class="press" bindtap="onFoldTap">
          <view class="fold-title">
            <text class="fold-name">{{item.m}} 月</text>
            <text class="fold-meta">{{item.hit.length}} 项进行中</text>
          </view>
          <view class="fold-caret {{item.open ? 'up' : ''}}"></view>
        </view>
        <view wx:if="{{item.open}}" class="fold-body">
          <view wx:for="{{item.hit}}" wx:for-item="g" wx:key="index" class="gm-row">
            <view class="gm-row-head">
              <text class="gm-row-title">{{g.title}}</text>
              <text class="gm-row-meta">{{g.group}}</text>
            </view>
            <view class="gm-bar-wrap">
              <view class="gm-bar-fill" style="width:{{g.width}}%;background:{{g.color}}"></view>
              <text class="gm-bar-range">{{g.rangeLabel}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="viz-panel">
    <view class="viz-head"><text class="vh-title">阶段甘特</text><text class="vh-meta">{{swimMonthLabel}}</text></view>
    <!-- 原为 31 列 × 月度格 + 220rpx 标签（2000rpx 起）→ 按分类折叠 + 占比条 -->
    <view class="sm-folds">
      <view wx:for="{{swimCats}}" wx:key="cat" class="fold">
        <view class="fold-head" data-key="sm-{{item.cat}}" hover-class="press" bindtap="onFoldTap">
          <view class="fold-title">
            <text class="fold-name">{{item.label}}</text>
            <text class="fold-meta">{{item.bars.length}} 块 · {{item.sumLabel}}</text>
          </view>
          <view class="fold-caret {{item.open ? 'up' : ''}}"></view>
        </view>
        <view wx:if="{{item.open}}" class="fold-body">
          <view class="sm-meter"><view class="sm-meter-fill" style="width:{{item.pct}}%;background:{{item.color}}"></view><text class="sm-meter-pct">{{item.pct}}%</text></view>
          <view wx:if="{{!item.bars.length}}" class="fold-empty">本月这个分类还没有安排</view>
          <view wx:for="{{item.bars}}" wx:for-item="b" wx:key="index" class="sm-item">
            <text class="sm-item-day">{{b.day}} 日</text>
            <view class="sm-item-main">
              <text class="sm-item-title">{{b.title}}</text>
              <text class="sm-item-dur">{{b.durMin}} 分钟</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
