/* 时间块（潮汐） */
.press { opacity: 0.8; transform: scale(0.99); }
.tb { padding-bottom: calc(220rpx + env(safe-area-inset-bottom)); }

/* ── 日期导航 ── */
.tl-head { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; }
.dnav { display: flex; gap: 10rpx; flex: none; }
.dnav-btn {
  width: 66rpx;
  height: 66rpx;
  border-radius: 14rpx;
  background: var(--paper);
  border: 2rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--deep);
  box-sizing: border-box;
}
.dlabel { display: flex; flex-direction: column; min-width: 0; }
.dlabel .d { font-size: 30rpx; font-weight: 700; }
.dlabel .sum { font-size: 22rpx; color: var(--ink-2); margin-top: 2rpx; }

/* ── 近 7 天日期条 ── */
.days { margin: 0 4rpx 20rpx; white-space: nowrap; }
.days-inner { display: inline-flex; gap: 12rpx; padding: 2rpx; }
.dchip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  min-width: 96rpx;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: var(--panel);
  box-shadow: 0 2rpx 8rpx rgba(34, 48, 58, 0.05);
  box-sizing: border-box;
}
.dchip .dmd { font-size: 24rpx; font-weight: 600; }
.dchip .dwk { font-size: 19rpx; color: var(--ink-3); }
.dchip.on { background: var(--deep); }
.dchip.on .dmd { color: var(--on-deep); }
.dchip.on .dwk { color: var(--on-deep); opacity: 0.72; }

/* ── 长按放置模式提示条 ── */
.placebar {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  right: 24rpx;
  background: var(--deep-2);
  color: #fff;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 10rpx 30rpx rgba(13, 31, 38, 0.35);
  z-index: 30;
}
.placebar .pt1 { font-size: 24rpx; line-height: 1.5; }
.placebar .pt2 { flex: none; font-size: 24rpx; padding: 6rpx 14rpx; opacity: 0.85; }

/* ── 空天提示 ── */
.day-empty {
  position: absolute;
  left: 96rpx;
  right: 20rpx;
  top: 45%;
  transform: translateY(-50%);
  text-align: center;
  color: var(--ink-3);
  font-size: 24rpx;
  line-height: 1.9;
  pointer-events: none;
}

/* ── 任务池 ── */
.pool { margin-bottom: 22rpx; }
.pt {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--ink-2);
  margin: 0 6rpx 12rpx;
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
}
.pt-hint { font-size: 20rpx; letter-spacing: 0; color: var(--ink-3); }
.plist { width: 100%; white-space: nowrap; }
.plist-inner { display: inline-flex; gap: 14rpx; padding: 4rpx 2rpx 8rpx; }
.ptask {
  display: inline-block;
  width: 330rpx;
  white-space: normal;
  background: var(--panel);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 3rpx 12rpx rgba(34, 48, 58, 0.06);
  box-sizing: border-box;
  vertical-align: top;
  min-height: 128rpx;
}
.ptask .n {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.ptask .m {
  display: flex;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--ink-2);
  margin-top: 8rpx;
  align-items: center;
  flex-wrap: wrap;
}
.pool-empty {
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  background: transparent;
  box-shadow: none;
}

/* ── 时间轴画布 ── */
/* 注意：内部 hour-row / movable-area 的 top 均按 px 精确计算，
   垂直方向不能有任何内边距，否则 928px 画布与 movable-area 错位 */
.canvas {
  position: relative;
  overflow: hidden;
  padding: 0;
  box-sizing: border-box;
}
.hour-row {
  position: absolute;
  left: 96rpx;
  right: 20rpx;
  height: 54px;
  border-bottom: 1px solid var(--line-soft);
}
.hour-row .h {
  position: absolute;
  left: -84rpx;
  top: -7px;
  font-size: 20rpx;
  color: var(--ink-3);
  font-variant-numeric: tabular-nums;
}
.ma { position: absolute; top: 10px; bottom: 0; left: 96rpx; right: 20rpx; }
.block {
  width: 100%;
  box-sizing: border-box;
  border-radius: 9px;
  padding: 7px 12px;
  color: var(--on-deep);
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
}
.block .bn {
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.block .bm { font-size: 10px; opacity: 0.85; margin-top: 2px; }
.block.tiny { padding: 4px 10px; }
.block.dragging {
  opacity: 0.78;
  box-shadow: 0 10px 24px rgba(34, 48, 58, 0.4);
}

.now-line {
  position: absolute;
  left: 84rpx;
  right: 36rpx;
  height: 2px;
  background: var(--coral);
  z-index: 5;
  pointer-events: none;
}
.now-line::before {
  content: "";
  position: absolute;
  left: -5px;
  top: -4px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--coral);
}
.now-line .t {
  position: absolute;
  right: 0;
  top: -18px;
  background: var(--coral);
  color: #fff;
  font-size: 10px;
  border-radius: 8px;
  padding: 2px 8px;
  white-space: nowrap;
}
.drop-hint {
  position: absolute;
  left: 88rpx;
  right: 32rpx;
  height: 3px;
  border-radius: 2px;
  background: var(--sea);
  z-index: 6;
  pointer-events: none;
}
.drop-hint .hl {
  position: absolute;
  right: 0;
  top: -24px;
  background: var(--sea);
  color: #fff;
  font-size: 10px;
  padding: 3px 9px;
  border-radius: 8px;
  white-space: nowrap;
}

/* ── 概览 ── */
.at {
  font-size: 22rpx;
  letter-spacing: 0.18em;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}
.bigrow { display: flex; align-items: baseline; gap: 10rpx; margin-bottom: 16rpx; }
.big { font-size: 46rpx; font-weight: 800; color: var(--deep); }
.small { font-size: 22rpx; color: var(--ink-3); }
.meter {
  display: flex;
  height: 14rpx;
  border-radius: 999rpx;
  overflow: hidden;
  gap: 2rpx;
  margin-bottom: 16rpx;
  background: var(--line-soft);
}
.seg { height: 100%; }
.legend { display: flex; flex-wrap: wrap; gap: 10rpx 26rpx; }
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--ink-2); }
.dot { width: 16rpx; height: 16rpx; border-radius: 50%; flex: none; }

.rhythm { display: flex; gap: 12rpx; align-items: flex-end; }
.r { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.rbar {
  width: 100%;
  height: 120rpx;
  display: flex;
  align-items: flex-end;
  background: var(--paper);
  border-radius: 8rpx;
  overflow: hidden;
}
.fill { width: 100%; background: var(--sea); min-height: 6rpx; }
.r.today .rbar { background: var(--accent-soft); }
.r.today .fill { background: var(--deep); }
.rd { font-size: 19rpx; color: var(--ink-3); }

.trow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line-soft);
}
.trow:last-child { border-bottom: none; }
.tlabel {
  flex: 1;
  font-size: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.du { font-size: 21rpx; color: var(--ink-3); flex: none; }

/* ── 底部快速输入 ── */
.addbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  display: flex;
  gap: 14rpx;
  align-items: center;
  background: var(--panel);
  border-radius: 18rpx;
  padding: 14rpx 18rpx;
  box-shadow: 0 8rpx 30rpx rgba(34, 48, 58, 0.16);
  z-index: 20;
}
.addbar .input { flex: 1; background: var(--paper); border: none; }

@media (max-width: 340px) {
  .tl-head { gap: 14rpx; padding: 18rpx 20rpx; }
  .dnav { gap: 8rpx; }
  .dnav-btn { width: 60rpx; height: 60rpx; }
  .dlabel .sum { display: none; }
  .ptask { width: 300rpx; }
  .hour-row { left: 86rpx; right: 14rpx; }
  .ma { left: 86rpx; right: 14rpx; }
  .now-line { left: 74rpx; right: 26rpx; }
  .drop-hint { left: 78rpx; right: 24rpx; }
  .addbar { left: 18rpx; right: 18rpx; padding: 12rpx 14rpx; }
}

/* ═══════ v0.38.0 时间视图切换：收进展开菜单 ═══════
   原来 7 个 tab 横排 + scroll-x，一屏只看得到 4 个半。 */
.vt-bar { display:flex; align-items:center; gap:14rpx; margin-bottom:18rpx; }
.vt-lead { font-size:22rpx; letter-spacing:.12em; color:var(--ink-2); flex:none; }
.vt-toggle {
  flex:1; min-width:0;
  display:flex; align-items:center; justify-content:space-between; gap:12rpx;
  padding:16rpx 20rpx; border-radius:14rpx;
  background:var(--panel); border:2rpx solid var(--line);
  box-sizing:border-box;
}
.vt-name { font-size:26rpx; font-weight:700; color:var(--deep); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.vt-caret {
  flex:none; width:0; height:0;
  border-left:9rpx solid transparent; border-right:9rpx solid transparent;
  border-top:11rpx solid var(--ink-3);
  transition:transform .16s ease;
}
.vt-caret.up { transform:rotate(180deg); }

.vt-mask { position:fixed; left:0; right:0; top:0; bottom:0; background:rgba(13,31,38,.28); z-index:40; }
.vt-menu {
  position:fixed; left:24rpx; right:24rpx;
  top:calc(env(safe-area-inset-top) + 120rpx);
  max-height:70vh; overflow-y:auto;
  background:var(--panel); border-radius:20rpx;
  box-shadow:0 20rpx 50rpx rgba(13,31,38,.28);
  padding:10rpx; box-sizing:border-box; z-index:41;
}
.vt-item {
  display:flex; align-items:center; gap:14rpx;
  padding:18rpx 18rpx; border-radius:14rpx;
  /* 触控目标 ≥ 88rpx（约 44px） */
  min-height:88rpx; box-sizing:border-box;
}
.vt-item.on { background:var(--accent-soft); }
.vt-item-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.vt-item-label { font-size:26rpx; font-weight:700; color:var(--ink); }
.vt-item.on .vt-item-label { color:var(--deep); }
.vt-item-desc { font-size:20rpx; color:var(--ink-3); line-height:1.4; }
.vt-item-check { flex:none; font-size:26rpx; font-weight:800; color:var(--deep); }

/* ═══════ v0.38.0 通用折叠分组 ═══════
   课程表按天 / 年度甘特按月 / 阶段甘特按分类共用。 */
.fold { background:var(--paper); border:2rpx solid var(--line-soft); border-radius:16rpx; overflow:hidden; margin-bottom:12rpx; }
.fold.is-today { border-color:var(--deep); }
.fold-head {
  display:flex; align-items:center; justify-content:space-between; gap:14rpx;
  min-height:96rpx; padding:16rpx 20rpx; box-sizing:border-box;
}
.fold-title { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.fold-name { font-size:26rpx; font-weight:700; color:var(--ink); }
.fold.is-today .fold-name { color:var(--deep); }
.fold-meta { font-size:20rpx; color:var(--ink-3); }
.fold-caret {
  flex:none; width:0; height:0;
  border-left:9rpx solid transparent; border-right:9rpx solid transparent;
  border-top:11rpx solid var(--ink-3);
  transition:transform .16s ease;
}
.fold-caret.up { transform:rotate(180deg); }
.fold-body { padding:0 20rpx 16rpx; border-top:2rpx solid var(--line-soft); padding-top:14rpx; }
.fold-empty { font-size:22rpx; color:var(--ink-3); text-align:center; padding:28rpx 0; }

/* 视图标题条右侧的补充信息（周次 / 年份 / 月份） */
.vh-meta { margin-left:auto; font-size:20rpx; color:var(--ink-3); font-variant-numeric:tabular-nums; }

/* ── 课程表按天折叠后的日程行 ── */
/* 只负责行本身 —— 外层留白统一交给 .fold-body，别再叠一层 padding（两个类同时命中会打架）。 */
.wk-days .wk-row:first-child { padding-top:0; }
.wk-row { display:flex; align-items:flex-start; gap:16rpx; padding:12rpx 0; border-bottom:1rpx solid var(--line-soft); }
.wk-row:last-child { border-bottom:none; }
.wk-row-time { flex:none; width:150rpx; font-size:20rpx; color:var(--ink-2); font-variant-numeric:tabular-nums; line-height:1.5; }
.wk-row-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.wk-row-title { font-size:24rpx; font-weight:600; line-height:1.45; word-break:break-all; }
.wk-row-meta { font-size:20rpx; color:var(--ink-3); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
/* 左侧色条沿用 cat-* 令牌（.block 用的同一套），列表里靠 padding-left + 边框呈现 */
.wk-row { border-left:6rpx solid transparent; padding-left:14rpx; border-radius:6rpx; }
.wk-row.cat-work { border-left-color:#168f88; }
.wk-row.cat-study { border-left-color:#26b99a; }
.wk-row.cat-sport { border-left-color:#e28aa1; }
.wk-row.cat-life { border-left-color:#6b8be0; }
.wk-row.cat-rest { border-left-color:#5bbf8f; }

/* ── 里程碑：纵向时间线 ── */
.ms-list { padding:20rpx 24rpx 8rpx; }
.ms-item { display:flex; gap:18rpx; }
.ms-rail { flex:none; width:32rpx; display:flex; flex-direction:column; align-items:center; }
.ms-node {
  width:22rpx; height:22rpx; border-radius:50%; flex:none;
  margin-top:14rpx; background:var(--ms);
  /* 光晕用半透明白描边，不用 color-mix —— 小程序的渲染引擎对 color-mix 支持不可靠，
     本仓库其余 WXSS 也一律没用到它（只有 max-width 媒体查询与 var()）。 */
  box-shadow:0 0 0 8rpx rgba(255,255,255,.75);
}
/* 竖线由 .ms-rail 的伪元素画，避免为每个节点补一个额外 view */
.ms-rail::after { content:""; flex:1; width:3rpx; background:var(--line); margin-top:10rpx; }
.ms-item:last-child .ms-rail::after { display:none; }
.ms-card { flex:1; min-width:0; padding:14rpx 0 26rpx; }
.ms-row1 { display:flex; align-items:center; gap:12rpx; margin-bottom:8rpx; }
.ms-date { color:#fff; font-size:19rpx; font-weight:700; padding:4rpx 12rpx; border-radius:6rpx; font-variant-numeric:tabular-nums; }
.ms-year-l { font-size:20rpx; color:var(--ink-3); font-variant-numeric:tabular-nums; }
.ms-title { display:block; font-size:25rpx; font-weight:700; line-height:1.45; word-break:break-all; }
.ms-sub { display:block; font-size:20rpx; color:var(--ink-3); line-height:1.5; margin-top:6rpx; }

/* ── 横向时间轴 → 纵向年表（中轴 + 左右交错） ── */
.chron-v { position:relative; padding:20rpx 24rpx 12rpx 24rpx; }
/* 中轴：绝对定位在容器正中 */
.chron-v::before {
  content:""; position:absolute; left:50%; top:24rpx; bottom:24rpx;
  width:3rpx; transform:translateX(-50%); background:var(--line);
}
.chron-v-item { position:relative; display:flex; align-items:flex-start; margin-bottom:20rpx; }
.chron-v-item.left { padding-right:calc(50% + 22rpx); }
.chron-v-item.right { padding-left:calc(50% + 22rpx); flex-direction:row-reverse; }
.chron-v-card {
  flex:1; min-width:0;
  background:var(--paper); border:2rpx solid var(--line-soft); border-radius:14rpx;
  padding:14rpx 16rpx; box-sizing:border-box;
  border-left:7rpx solid var(--ec);
}
.chron-v-item.right .chron-v-card { border-left:2rpx solid var(--line-soft); border-right:7rpx solid var(--ec); }
.cv-title { display:block; font-size:24rpx; font-weight:700; line-height:1.45; word-break:break-all; }
.cv-sub { display:block; font-size:20rpx; color:var(--ink-3); line-height:1.5; margin-top:6rpx; word-break:break-all; }
/* 节点圆点压在轴上 */
.chron-v-dot {
  position:absolute; left:50%; top:22rpx;
  width:20rpx; height:20rpx; border-radius:50%;
  transform:translateX(-50%); background:var(--ec);
  box-shadow:0 0 0 7rpx var(--panel);
}
.chron-v-date {
  position:absolute; top:16rpx; color:#fff; font-size:18rpx; font-weight:700;
  padding:4rpx 10rpx; border-radius:6rpx; font-variant-numeric:tabular-nums;
}
.chron-v-item.left .chron-v-date { left:calc(50% + 22rpx); }
.chron-v-item.right .chron-v-date { right:calc(50% + 22rpx); }
/* 长间隔省略提示（与桌面端 chronicle 同语义） */
.chron-v-gap {
  display:block; text-align:center; margin:4rpx 0 20rpx; padding:0 16rpx;
  font-size:20rpx; font-weight:700; letter-spacing:2rpx; color:var(--ink-3);
  background:var(--panel);
}

/* ── 年度甘特：按月折叠后的行 ── */
.gm-folds { padding:14rpx 20rpx 4rpx; }
.gm-row { padding:16rpx 0; border-bottom:1rpx solid var(--line-soft); }
.gm-row:last-child { border-bottom:none; }
.gm-row-head { display:flex; align-items:baseline; justify-content:space-between; gap:14rpx; margin-bottom:10rpx; }
.gm-row-title { flex:1; min-width:0; font-size:24rpx; font-weight:600; line-height:1.45; word-break:break-all; }
.gm-row-meta { flex:none; font-size:19rpx; color:var(--ink-3); }
.gm-bar-wrap { position:relative; height:44rpx; border-radius:10rpx; background:var(--line-soft); overflow:hidden; }
.gm-bar-fill { height:100%; border-radius:10rpx; }
.gm-bar-range {
  position:absolute; right:10rpx; top:50%; transform:translateY(-50%);
  font-size:18rpx; font-weight:700; color:var(--ink-2);
  font-variant-numeric:tabular-nums;
  /* 条短时文字会压在色块上，所以给它一块半透明底（同 .ms-node：不用 color-mix） */
  background:rgba(255,255,255,.82);
  padding:2rpx 8rpx; border-radius:6rpx;
}

/* ── 阶段甘特：按分类折叠后的条目 ── */
.sm-folds { padding:14rpx 20rpx 4rpx; }
/* 占比条放在分类标题下（口径 = 该分类时长 / 当月总时长，与桌面端一致），
   不是每条一个 —— 条目级占比会变成「这根条占了 31 格的多少」，没有意义。 */
.sm-meter { position:relative; display:flex; align-items:center; height:32rpx; border-radius:999rpx; background:var(--line-soft); overflow:hidden; margin-bottom:14rpx; }
.sm-meter-fill { height:100%; border-radius:999rpx; }
.sm-meter-pct { position:absolute; right:12rpx; font-size:18rpx; font-weight:700; color:var(--ink-2); font-variant-numeric:tabular-nums; }
.sm-item { display:flex; align-items:flex-start; gap:14rpx; padding:12rpx 0; border-bottom:1rpx solid var(--line-soft); }
.sm-item:last-child { border-bottom:none; }
.sm-item-day { flex:none; width:96rpx; font-size:20rpx; color:var(--ink-3); font-variant-numeric:tabular-nums; line-height:1.5; }
.sm-item-main { flex:1; min-width:0; display:flex; flex-direction:column; gap:4rpx; }
.sm-item-title { font-size:23rpx; font-weight:600; line-height:1.45; word-break:break-all; }
.sm-item-dur { font-size:19rpx; color:var(--ink-3); }

.viz-panel { background:var(--panel); border-radius:20rpx; box-shadow:0 4rpx 16rpx rgba(34,48,58,.07); overflow:hidden; margin-bottom:24rpx; }
.viz-head { padding:20rpx 26rpx; border-bottom:2rpx solid var(--line-soft); display:flex; align-items:center; }
.vh-title { font-size:30rpx; font-weight:800; }
/* .vh-sub 已停用：视图标题下的说明文案纯占位，各端已删除（v0.37.19）。 */

/* ── 交错卡片时间轴：直接单列（不再按屏宽分叉） ── */
.cards-mobile { position:relative; padding-bottom:28rpx; }
.cards-axis { position:absolute; left:42rpx; top:110rpx; bottom:30rpx; border-left:4rpx dashed #a99bd2; }
.timeline-card { position:relative; display:flex; margin-left:0; padding:24rpx 20rpx 16rpx 100rpx; justify-content:flex-start; }
.tm-card { width:100%; border:2rpx solid; border-radius:20rpx; padding:22rpx; display:flex; flex-direction:column; gap:10rpx; box-sizing:border-box; }
.tm-date { font-size:22rpx; font-weight:800; }
.tm-title { font-size:26rpx; font-weight:800; line-height:1.4; word-break:break-all; }
.tm-sub { font-size:20rpx; color:var(--ink-2); line-height:1.6; word-break:break-all; }
.tm-link { position:absolute; top:60rpx; left:46rpx; width:44rpx; border-top:4rpx dashed; }

